# Intel Quartus Prime - .gitignore
#
# Principio: ignora-se o que a ferramenta recria sozinha. Tudo que e fonte
# (VHDL, SDC, scripts) ou resultado consolidado (metricas, tabelas, relatorio
# de STA) fica versionado.
#
# Nao use padroes largos como "*.txt" aqui. O projeto gera relatorios .txt
# que interessam, e uma regra generica os esconde silenciosamente.

# -------------------------------------
# Bancos de dados e diretorios de compilacao
# -------------------------------------
db/
incremental_db/
greybox_tmp/
hc_output/
.qsys_edit/
.ipcache/
output_files/

# -------------------------------------
# Simulacao
# -------------------------------------
simulation/
modelsim/
work/
work_equiv/
transcript
msim_transcript
vsim.wlf
*.mpf
*.mti
*.ini

# -------------------------------------
# Dados intermediarios e saidas volumosas
#
# Os datasets em ponto fixo e os despejos brutos do testbench sao derivados
# dos CSVs em archive_final/ e chegam a centenas de milhares de linhas.
# Reproduzem-se com run_experiment.ps1.
# -------------------------------------
dados_pre_processados/
results/dados_pre_processados/
optimization_runs/
results/optimization_runs/
graficos_uteis/
results/graficos_uteis/
results_final/graficos_uteis/
*_results.txt
*_dataset.txt
dataset_scaled.txt

# -------------------------------------
# Relatorios e logs do Quartus
#
# Sao regerados a cada compilacao. O que se guarda do fluxo de timing sao os
# arquivos de results_final/sta/, produzidos por scripts/run_sta.tcl.
# -------------------------------------
*.rpt
*.summary
*.log
*.done
*.smsg
*.qmsg
*.jdi
*.pin
*.qws
*.sld
*.hex

# Despejo do modelo de pinos do Cyclone V. Descreve o dispositivo, nao o
# projeto: e identico para qualquer design no mesmo chip.
c5_pin_model_dump.txt
PLLJ_PLLSPE_INFO.txt

# Excecao explicita: o relatorio de STA e evidencia dos numeros publicados.
!results_final/sta/sta_full_report.txt

# -------------------------------------
# Bitstreams
#
# Descomente se quiser versionar releases de bitstream.
# -------------------------------------
*.sof
*.pof
*.jic
*.ekp
*.rbf
*.svf

# -------------------------------------
# Qsys / Platform Designer
# -------------------------------------
*_generation_script.tcl
*_generation.rpt
*_inst.v
*_inst.vhd
*_bb.v

# -------------------------------------
# Python
# -------------------------------------
__pycache__/
*.pyc
.venv/

# -------------------------------------
# Temporarios e backup
# -------------------------------------
*.bak
*.v.bak
*.vhd.bak
*.orig
*~
